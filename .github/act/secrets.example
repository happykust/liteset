# Local secrets for running CI with `act`.
#
#   cp .github/act/secrets.example .github/act/secrets
#   # fill in values, then:
#   act -j unit-tests --secret-file .github/act/secrets
#
# .github/act/secrets is git-ignored — never commit real tokens.

# Needed by steps that call the GitHub API. For most local runs the
# change-detector is bypassed (act sets ACT=true), so a dummy value is fine.
GITHUB_TOKEN=ghp_dummy_token_for_act

# Optional. Codecov uploads are non-fatal (fail_ci_if_error: false), leave empty
# unless you actually want to push coverage from a local run.
CODECOV_TOKEN=

# NOTE: PyPI publishing (tag-release.yml) uses OIDC Trusted Publishing — no token.
# Configure the trusted publisher on PyPI (see .github/CI_SETUP.md §3.1). npm is not
# published (those workflows were removed). Nothing to put here for releases.

# Anthropic key for the Claude PR assistant (claude.yml):
ANTHROPIC_API_KEY=
